{
  "private": true,
  "type": "module",
  "description": "Novel Desk: サーバーなしで動く Novel Writer の JavaScript 版。画面は素の ES modules（ライブラリなし、ビルドなし）。ここにあるのは開発用の点検と試験だけ",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "format": "prettier --write \"**/*.{js,mjs}\"",
    "format:check": "prettier --check \"**/*.{js,mjs}\"",
    "lint:js": "eslint .",
    "check:types": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "test:unit": "vitest run --coverage",
    "test:props": "vitest run -c vitest.props.config.mjs",
    "test:ui": "playwright test",
    "test:mutation": "stryker run",
    "test:mutation:save": "stryker run stryker.save.config.mjs",
    "check:trace": "NW_NO_WEBKIT=1 playwright test trace && node tools/trace_check.mjs",
    "check:server": "node tools/server_diff.mjs",
    "check:all": "bash tools/check_all.sh",
    "check:ui": "bash tools/check_ui.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
